<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NASMovie" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand colors. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Toolbar icon color (包括溢出菜单按钮) -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorOnSurface">@android:color/white</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="backgroundColor">@color/colorBackground</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>

        <!-- Action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Player theme (fullscreen) -->
    <style name="Theme.NASMovie.Player" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Card style -->
    <style name="MovieCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <!-- Movie title text style -->
    <style name="MovieTitleStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Detail title text style -->
    <style name="DetailTitleStyle">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rating badge style -->
    <style name="RatingBadgeStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/bg_rating_badge</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- Transparent Bottom Sheet Dialog -->
    <style name="Theme.NASMovie.BottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Style.NASMovie.BottomSheet</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="Style.NASMovie.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <!-- 透明背景让布局自己的圆角背景生效 -->
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>